{
  "name": "mighty-search",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test --test-timeout=120000 \"tests/e2e/*.e2e.js\"",
    "check": "node scripts/check-cache-bust.mjs && npm test --silent",
    "bump": "node scripts/bump-version.mjs",
    "shots": "node scripts/shots.mjs",
    "probe": "node scripts/probe.mjs",
    "build:stores": "node scripts/build-stores.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0"
  }
}
